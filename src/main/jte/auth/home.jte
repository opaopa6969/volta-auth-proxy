@param String title
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${title}</title>
    <link rel="stylesheet" href="/css/volta.css">
</head>
<body>
<main class="container">
    <h1>Volta 認証</h1>
    <p class="muted">ログイン後に、一時アクセスの発行と管理を行えます。</p>
    <p><a class="button" href="/admin/invitations">一時アクセスを発行・管理</a></p>
    <p><a href="/console/">認証コンソールを開く</a> · <a href="https://index.unlaxer.org/">Index Hub を開く</a></p>
</main>
</body>
</html>
